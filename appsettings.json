{
  "ConnectionStrings": {
    "LogDataBase": "Host=localhost;Port=5432;Database=MyApiLogs;Username=postgres;Password=mystrongpassword"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.PostgreSQL.Alternative"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "MyTodoApi"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "LogDataBase",
          "tableName": "AuditLogs",
          "needAutoCreateTable": false,
          
          "columnOptions": {
            "removeStandardColumns": true,

            "customColumns": [
              {
                "columnName": "UserId",
                "dataType": "integer",
                "propertyName": "UserId",
                "writer": "Serilog.Sinks.PostgreSQL.ColumnWriters.SinglePropertyColumnWriter, Serilog.Sinks.PostgreSQL.Alternative"
              },
              {
                "columnName": "ActionId",
                "dataType": "integer",
                "propertyName": "ActionId",
                "writer": "Serilog.Sinks.PostgreSQL.ColumnWriters.SinglePropertyColumnWriter, Serilog.Sinks.PostgreSQL.Alternative"
              },
              {
                "columnName": "CreatedAt",
                "dataType": "timestamp with time zone",
                "writer": "Serilog.Sinks.PostgreSQL.ColumnWriters.TimestampColumnWriter, Serilog.Sinks.PostgreSQL.Alternative"
              },
              {
                "columnName": "Description",
                "dataType": "jsonb",
                "writer": "Serilog.Sinks.PostgreSQL.ColumnWriters.LogEventSerializedColumnWriter, Serilog.Sinks.PostgreSQL.Alternative"
              }
            ]
          }
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
